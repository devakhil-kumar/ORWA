# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ORWA' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end  # 👈 target block ends HERE

post_install do |installer|
  react_native_post_install(installer, :mac_catalyst_enabled => false)

  # Patch fmt base.h
  base_h = "#{installer.sandbox.root}/fmt/include/fmt/base.h"
  real_path = File.realpath(base_h) rescue nil
  if real_path && File.exist?(real_path)
    content = File.read(real_path)
    if content.include?('FMT_CONSTEVAL consteval')
      File.write(real_path, content.gsub('FMT_CONSTEVAL consteval', 'FMT_CONSTEVAL constexpr'))
      puts "✅ Patched fmt/base.h"
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # ✅ Only set deployment target globally
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end

    # ✅ Apply C++ standard ONLY to fmt — don't touch hermes
    if target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
      end
    end
  end
end